LINK_DAYBEAT=''
COMPANY=''
USERNAME_DAYBEAT=''
PASSWORD=''
# Ruta raíz donde buscar repositorios git. Acepta rutas Linux (/home/user/repos)
# o UNC de Windows (//wsl.localhost/distro/home/user/repos). Se adapta automáticamente.
ROOT_DIR=''
GIT_AUTHOR_EMAIL=''
GEMINI_API_KEY=''
GEMINI_MODEL='gemini-3.5-flash'
# Atlassian Jira (opcional) — habilita el modo "Con información de Jira"
# Modo OAuth 2.1 (recomendado): solo ATLASSIAN_ENABLED=true. La primera
# ejecución abre el navegador para autorizar (una sola vez, tokens persistidos
# y refresh automático, sin depender del admin de la org). El navegador trae
# la identidad: no hace falta email ni token.
# Alternativa silenciosa: sumá ATLASSIAN_EMAIL + ATLASSIAN_API_TOKEN
# (https://id.atlassian.com/manage-profile/security/api-tokens) para usar
# Basic en vez de OAuth. El MCP oficial requiere que la org habilite el API
# token, pero REST (comentarios/worklogs) funciona igual en ambos modos.
ATLASSIAN_ENABLED=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
# Opcional: si se omite, se autodetecta el sitio (cloudId + site URL)
ATLASSIAN_CLOUD_ID=
ATLASSIAN_SITE_URL=
# HEADLESS: 'true' ejecuta sin ventana del navegador (headless); 'false' (default) la muestra
HEADLESS=false

# ---------------------------------------------------------------------------
# IA — OpenCode Zen (alternativa a GEMINI_API_KEY, configurable desde el menú
# "6. Config IA" del script; no hace falta tocar este archivo)
# ---------------------------------------------------------------------------
# OpenCode Zen da modelos GRATIS (*-free) con la cuenta gratuita de opencode
# (https://opencode.ai/auth). El script importa la key automáticamente desde
# el auth.json del CLI de opencode (~/.local/share/opencode/auth.json) o la
# acepta pegada manualmente. Se guarda en .daybeat-ai.json (gitignored).
#
# La configuración de IA (provider activo, keys, modelos) vive en
# .daybeat-ai.json, generado desde el menú "6. Config IA". Si existe
# GEMINI_API_KEY y no hay config, el script se comporta como antes.
#
# Modelos gratis de OpenCode Zen (default: deepseek-v4-flash-free):
#   deepseek-v4-flash-free, mimo-v2.5-free, hy3-free, laguna-s-2.1-free,
#   nemotron-3-ultra-free, nemotron-3.5-lightning-free, big-pickle
